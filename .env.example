# Server-side environment variables template (placeholders only — never commit real secrets)
# Configure real secrets via your hosting provider's Secrets panel or a local ignored .env file.
# Never prefix private secrets with VITE_ (Vite exposes VITE_* variables to browser code).

# GEMINI_API_KEY: Server-side only key for Gemini API routes (/api/*).
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: Public URL where this application is hosted.
APP_URL=https://your-app-url.example.com
